// The wire field type of property key `key` (RIV_FIELD_*), or -1 when the
// pinned runtime does not know the key.
export function rivFieldType(key: u32): i32 {
    if (key > 0xFFFF) return -1;
    let lo = 0;
    let hi = RIV_FIELD_KEYS.length - 1;
    while (lo <= hi) {
        const mid = (lo + hi) >> 1;
        const k = <u32>RIV_FIELD_KEYS[mid];
        if (k == key) return <i32>RIV_FIELD_TYPES[mid];
        if (k < key) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}
