// Derived from meshopt-rs 0.1.2 (MIT); see THIRD_PARTY_NOTICES.md.
//
// Triangle index buffer encoding and decoding (meshoptimizer bitstream,
// header 0xE0 | version; v0 and v1).
//
// The destination is a Uint32Array; a 16-bit view narrows afterwards.

import { panic, Result } from "../../../../base/util";
import { ByteReader, DecodeError, decodeFail, decodeOk } from "../util";
import { decodeVByte } from "./mod";

export const INDEX_HEADER: u8 = 0xe0;

// Marks an empty slot in the vertex and edge fifos.
export const INVALID_INDEX: u32 = u32.MAX_VALUE;

// TRIANGLE_INDEX_ORDER[r][j] as a flat table.
export const TRIANGLE_INDEX_ORDER: StaticArray<i32> = [0, 1, 2, 1, 2, 0, 2, 0, 1];

export const CODE_AUX_ENCODING_TABLE: StaticArray<u8> = [
    0x00, 0x76, 0x87, 0x56, 0x67, 0x78, 0xa9, 0x86, 0x65, 0x89, 0x68, 0x98, 0x01, 0x69, 0,
    0, // last two entries aren't used for encoding
];

// DEFAULT_VERTEX_FIFO: 16 x INVALID_INDEX.
export function defaultVertexFifo(): Uint32Array {
    const f = new Uint32Array(16);
    f.fill(INVALID_INDEX);
    return f;
}

// DEFAULT_EDGE_FIFO: 16 x [INVALID_INDEX; 2], flattened (edge i at 2i, 2i+1).
export function defaultEdgeFifo(): Uint32Array {
    const f = new Uint32Array(32);
    f.fill(INVALID_INDEX);
    return f;
}

// The mutable fifo offsets, updated in place by the helpers.
export class Offsets {
    edge: i32 = 0;
    vertex: i32 = 0;
}

export function rotateTriangle(b: u32, c: u32, next: u32): i32 {
    if (b == next) {
        return 1;
    } else {
        if (c == next) {
            return 2;
        } else {
            return 0;
        }
    }
}

export function getEdgeFifo(fifo: Uint32Array, a: u32, b: u32, c: u32, offset: i32): i32 {
    for (let i = 0; i < 16; i++) {
        const index = (offset - (i + 1)) & 15;

        const e0 = fifo[index * 2];
        const e1 = fifo[index * 2 + 1];

        if (e0 == a && e1 == b) {
            return (i << 2) | 0;
        }

        if (e0 == b && e1 == c) {
            return (i << 2) | 1;
        }

        if (e0 == c && e1 == a) {
            return (i << 2) | 2;
        }
    }

    return -1;
}

export function pushEdgeFifo(fifo: Uint32Array, a: u32, b: u32, off: Offsets): void {
    fifo[off.edge * 2] = a;
    fifo[off.edge * 2 + 1] = b;
    off.edge = (off.edge + 1) & 15;
}

export function getVertexFifo(fifo: Uint32Array, v: u32, offset: i32): i32 {
    for (let i = 0; i < 16; i++) {
        const index = (offset - (i + 1)) & 15;

        if (fifo[index] == v) {
            return i;
        }
    }

    return -1;
}

// Pushes `v` into the vertex fifo; the offset advances only when `cond`.
export function pushVertexFifo(fifo: Uint32Array, v: u32, off: Offsets, cond: bool): void {
    fifo[off.vertex] = v;
    off.vertex = (off.vertex + (cond ? 1 : 0)) & 15;
}

function decodeIndex(data: ByteReader, last: u32): u32 {
    const v = decodeVByte(data);
    const d: u32 = (v >> 1) ^ <u32>(-(<i32>(v & 1)));

    return last + d;
}

export function getCodeAuxIndex(v: u8, table: StaticArray<u8>): i32 {
    for (let i = 0; i < 16; i++) {
        if (table[i] == v) return i;
    }
    return -1;
}

function writeTriangle(destination: Uint32Array, at: i32, a: u32, b: u32, c: u32): void {
    destination[at] = a;
    destination[at + 1] = b;
    destination[at + 2] = c;
}

// Decodes index data from an array of bytes generated by encodeIndexBuffer
// into `destination`, which must have the exact size of the index buffer.
//
// Ok(true) on success; otherwise the error's debug name is in `r.err`. Safe for
// untrusted input, but it may produce garbage data (e.g. out of range indices).
export function decodeIndexBuffer(destination: Uint32Array, buffer: Uint8Array): Result<bool> {
    const n = destination.length;
    if (n % 3 != 0) panic("assertion `left == right` failed");

    // the minimum valid encoding is header, 1 byte per triangle and a 16-byte codeaux table
    if (buffer.length < 1 + n / 3 + 16) {
        return decodeFail(DecodeError.UnexpectedEof);
    }

    if ((buffer[0] & 0xf0) != INDEX_HEADER) {
        return decodeFail(DecodeError.InvalidHeader);
    }

    const version = <i32>(buffer[0] & 0x0f);
    if (version > 1) {
        return decodeFail(DecodeError.UnsupportedVersion);
    }

    const edgefifo = defaultEdgeFifo();
    const vertexfifo = defaultVertexFifo();

    const off = new Offsets();

    let next: u32 = 0;
    let last: u32 = 0;

    const fecmax = version >= 1 ? 13 : 15;

    // since we store 16-byte codeaux table at the end, triangle data has to begin before data_safe_end
    const code = new ByteReader(buffer, 1, n / 3);
    const dataStart = 1 + n / 3;
    const data = new ByteReader(buffer, dataStart, buffer.length - dataStart);
    const dataSafeEnd = data.len - 16;
    const codeauxTable = dataStart + dataSafeEnd;

    for (let t = 0; t < n; t += 3) {
        // make sure we have enough data to read for a triangle
        // each triangle reads at most 16 bytes of data: 1b for codeaux and 5b for each free index
        // after this we can be sure we can read without extra bounds checks
        if (data.pos > dataSafeEnd) {
            return decodeFail(DecodeError.UnexpectedEof);
        }

        const codetri = <i32>code.readByte();

        if (codetri < 0xf0) {
            const fe = codetri >> 4;

            // fifo reads are wrapped around 16 entry buffer
            const a = edgefifo[((off.edge - (fe + 1)) & 15) * 2];
            const b = edgefifo[((off.edge - (fe + 1)) & 15) * 2 + 1];

            const fec = codetri & 15;

            // note: this is the most common path in the entire decoder
            // inside this if we try to stay branchless (by using cmov/etc.) since these aren't predictable
            if (fec < fecmax) {
                // fifo reads are wrapped around 16 entry buffer
                const cf = vertexfifo[(off.vertex - (fec + 1)) & 15];
                const c = fec == 0 ? next : cf;

                const fec0 = fec == 0;
                next += fec0 ? 1 : 0;

                // output triangle
                writeTriangle(destination, t, a, b, c);

                // push vertex/edge fifo must match the encoding step *exactly* otherwise the data will not be decoded correctly
                pushVertexFifo(vertexfifo, c, off, fec0);

                pushEdgeFifo(edgefifo, c, b, off);
                pushEdgeFifo(edgefifo, a, c, off);
            } else {
                // fec - (fec ^ 3) decodes 13, 14 into -1, 1
                // note that we need to update the last index since free indices are delta-encoded
                const c = fec != 15
                    ? last + <u32>(fec - (fec ^ 3))
                    : decodeIndex(data, last);
                last = c;

                // output triangle
                writeTriangle(destination, t, a, b, c);

                // push vertex/edge fifo must match the encoding step *exactly* otherwise the data will not be decoded correctly
                pushVertexFifo(vertexfifo, c, off, true);

                pushEdgeFifo(edgefifo, c, b, off);
                pushEdgeFifo(edgefifo, a, c, off);
            }
        } else {
            // fast path: read codeaux from the table
            if (codetri < 0xfe) {
                const codeaux = <i32>buffer[codeauxTable + (codetri & 15)];

                // note: table can't contain feb/fec=15
                const feb = codeaux >> 4;
                const fec = codeaux & 15;

                // fifo reads are wrapped around 16 entry buffer
                // also note that we increment next for all three vertices before decoding indices - this matches encoder behavior
                const a = next;
                next += 1;

                const bf = vertexfifo[(off.vertex - feb) & 15];
                const b = feb == 0 ? next : bf;

                const feb0 = feb == 0;
                next += feb0 ? 1 : 0;

                const cf = vertexfifo[(off.vertex - fec) & 15];
                const c = fec == 0 ? next : cf;

                const fec0 = fec == 0;
                next += fec0 ? 1 : 0;

                // output triangle
                writeTriangle(destination, t, a, b, c);

                // push vertex/edge fifo must match the encoding step *exactly* otherwise the data will not be decoded correctly
                pushVertexFifo(vertexfifo, a, off, true);
                pushVertexFifo(vertexfifo, b, off, feb0);
                pushVertexFifo(vertexfifo, c, off, fec0);

                pushEdgeFifo(edgefifo, b, a, off);
                pushEdgeFifo(edgefifo, c, b, off);
                pushEdgeFifo(edgefifo, a, c, off);
            } else {
                // slow path: read a full byte for codeaux instead of using a table lookup
                const codeaux = <i32>data.readByte();

                const fea = codetri == 0xfe ? 0 : 15;
                const feb = codeaux >> 4;
                const fec = codeaux & 15;

                // reset: codeaux is 0 but encoded as not-a-table
                if (codeaux == 0) {
                    next = 0;
                }

                // fifo reads are wrapped around 16 entry buffer
                // also note that we increment next for all three vertices before decoding indices - this matches encoder behavior
                let a: u32 = 0;
                if (fea == 0) {
                    a = next;
                    next += 1;
                }
                let b: u32 = 0;
                if (feb == 0) {
                    b = next;
                    next += 1;
                } else {
                    b = vertexfifo[(off.vertex - feb) & 15];
                }
                let c: u32 = 0;
                if (fec == 0) {
                    c = next;
                    next += 1;
                } else {
                    c = vertexfifo[(off.vertex - fec) & 15];
                }

                // note that we need to update the last index since free indices are delta-encoded
                if (fea == 15) {
                    a = decodeIndex(data, last);
                    last = a;
                }

                if (feb == 15) {
                    b = decodeIndex(data, last);
                    last = b;
                }

                if (fec == 15) {
                    c = decodeIndex(data, last);
                    last = c;
                }

                // output triangle
                writeTriangle(destination, t, a, b, c);

                // push vertex/edge fifo must match the encoding step *exactly* otherwise the data will not be decoded correctly
                pushVertexFifo(vertexfifo, a, off, true);
                pushVertexFifo(vertexfifo, b, off, (feb == 0) || (feb == 15));
                pushVertexFifo(vertexfifo, c, off, (fec == 0) || (fec == 15));

                pushEdgeFifo(edgefifo, b, a, off);
                pushEdgeFifo(edgefifo, c, b, off);
                pushEdgeFifo(edgefifo, a, c, off);
            }
        }
    }

    if (data.pos == dataSafeEnd) {
        return decodeOk();
    } else {
        // we should've read all data bytes and stopped at the boundary between data and codeaux table
        return decodeFail(DecodeError.ExtraBytes);
    }
}
