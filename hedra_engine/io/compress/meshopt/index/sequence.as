//
// Index sequence encoding and decoding (meshoptimizer bitstream, header
// 0xD0 | version).
//
// The destination is a Uint32Array.

import { Result } from "../../../../base/util";
import { ByteReader, DecodeError, decodeFail, decodeOk } from "../util";
import { decodeVByte } from "./mod";

export const SEQUENCE_HEADER: u8 = 0xd0;

// Decodes index data from an array of bytes generated by encodeIndexSequence
// into `destination`, which must have the exact size of the sequence.
//
// Ok(true) on success; otherwise the error's debug name is in `r.err`. Safe for
// untrusted input, but it may produce garbage data (e.g. out of range indices).
export function decodeIndexSequence(destination: Uint32Array, buffer: Uint8Array): Result<bool> {
    const n = destination.length;

    // the minimum valid encoding is header, 1 byte per index and a 4-byte tail
    if (buffer.length < 1 + n + 4) {
        return decodeFail(DecodeError.UnexpectedEof);
    }

    const data = new ByteReader(buffer, 0, buffer.length);
    const first = data.readByte();

    if ((first & 0xf0) != SEQUENCE_HEADER) {
        return decodeFail(DecodeError.InvalidHeader);
    }

    const version = first & 0x0f;
    if (version > 1) {
        return decodeFail(DecodeError.UnsupportedVersion);
    }

    const last = new StaticArray<u32>(2);

    for (let i = 0; i < n; i++) {
        let v = decodeVByte(data);

        // decode the index of the last baseline
        const current = <i32>(v & 1);
        v >>= 1;

        // reconstruct index as a delta
        const d: u32 = (v >> 1) ^ <u32>(-(<i32>(v & 1)));
        const index: u32 = last[current] + d;

        // update last for the next iteration that uses it
        last[current] = index;

        destination[i] = index;
    }

    if (data.remaining() == 4) {
        return decodeOk();
    } else {
        // we should've read all data bytes and stopped at the boundary between data and tail
        return decodeFail(DecodeError.ExtraBytes);
    }
}
