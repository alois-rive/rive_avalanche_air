// The degree sign (U+00B0), the one glyph past ASCII: the model editor's
// rotate header reads "Rotate Z: 30°".
export const DEGREE_GLYPH: string = ".##..#..#.#..#..##.................";

// The glyph of code point `c`: code points below 32 saturate to index 0 (space), those
// past the table give '?' (but the degree sign).
export function glyph(c: u32): string {
    if (c == 0xb0) return DEGREE_GLYPH;
    const idx = c < 32 ? 0 : c - 32;
    return idx < <u32>GLYPHS.length ? GLYPHS[<i32>idx] : GLYPHS[31]; // '?' for unknown
}

// Pixel width of `text` at `scale` (1-cell gap between glyphs).
export function textWidth(text: string, scale: u32): u32 {
    const n = <u32>charCount(text);
    if (n == 0) {
        return 0;
    } else {
        return (n * (GLYPH_W + 1) - 1) * scale;
    }
}

export function textHeight(scale: u32): u32 {
    return GLYPH_H * scale;
}

// Draw `text` with its top-left corner at `(x, y)`.
export function drawText(img: Image, x: i32, y: i32, text: string, scale: u32, color: Rgba): void {
    let cx = x;
    const s = <i32>scale;
    const len = text.length;
    let i = 0;
    // Walks the code points.
    while (i < len) {
        const ch = <u32>text.codePointAt(i);
        i += ch > 0xffff ? 2 : 1;
        const g = glyph(ch);
        for (let row = 0; row < <i32>GLYPH_H; row++) {
            for (let col = 0; col < <i32>GLYPH_W; col++) {
                const k = row * <i32>GLYPH_W + col;
                if (k < g.length && g.charCodeAt(k) == 0x23) { // '#'
                    img.fillRect(cx + col * s, y + row * s, s, s, color);
                }
            }
        }
        cx += (<i32>GLYPH_W + 1) * s;
    }
}

// Text on a translucent box, the label style used for ids and view names.
export function drawLabel(img: Image, x: i32, y: i32, text: string, scale: u32, fg: Rgba, bg: Rgba): void {
    const w = <i32>textWidth(text, scale);
    const h = <i32>textHeight(scale);
    const pad = <i32>scale;
    img.fillRect(x - pad, y - pad, w + 2 * pad, h + 2 * pad, bg);
    drawText(img, x, y, text, scale, fg);
}
