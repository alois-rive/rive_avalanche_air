<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/make_run.py: do not edit. The run's scene: the PSX
     frame rig (docs/LOOK.md, section 1) with the course, the rider, the sound
     and the lens under LowRes; the driver and the pins on the root. -->
<rscn format="2">
  <ext_resource id="1_present" type="Shader" path="res://psx/psx_present.wgsl"/>
  <ext_resource id="3_run" type="Script" path="res://scripts/run.as"/>
  <ext_resource id="4_sound" type="Script" path="res://scripts/sound.as"/>
  <ext_resource id="5_camera" type="Script" path="res://scripts/camera.as"/>
  <ext_resource id="6_course" type="PackedScene" path="res://course/course.rscn"/>
  <ext_resource id="7_rider" type="PackedScene" path="res://rider/rider.rscn"/>

  <!-- the view model the scene's bindings use: the Scene3D's `data`, GameData
       (make_rml.py declares it from tools/pins.py) -->
  <sub_resource id="VM_game" type="ViewModel">
    <property name="view_model">"GameData"</property>
  </sub_resource>
  <sub_resource id="Env_frame" type="Environment">
    <property name="background_mode">1</property>
    <property name="background_color">Color(0, 0, 0, 1)</property>
    <property name="tonemap_mode">0</property>
  </sub_resource>
  <sub_resource id="Tex_low" type="ViewportTexture">
    <property name="viewport_path">NodePath("LowRes")</property>
  </sub_resource>
  <sub_resource id="Mat_present" type="ShaderMaterial">
    <property name="shader">ExtResource("1_present")</property>
    <property name="shader_parameter/screen">SubResource("Tex_low")</property>
    <property name="shader_parameter/low_res">Vector2(320, 240)</property>
  </sub_resource>
  <sub_resource id="Mesh_present" type="QuadMesh">
    <property name="material">SubResource("Mat_present")</property>
  </sub_resource>
  <!-- gap E-VPTEX: a standard slot names the viewport texture so its target is made -->
  <sub_resource id="Mat_anchor" type="StandardMaterial3D">
    <property name="shading_mode">0</property>
    <property name="albedo_texture">SubResource("Tex_low")</property>
  </sub_resource>
  <sub_resource id="Mesh_anchor" type="QuadMesh">
    <property name="size">Vector2(0.001, 0.001)</property>
    <property name="material">SubResource("Mat_anchor")</property>
  </sub_resource>

  <node name="Run" type="Node3D">
    <property name="script">ExtResource("3_run")</property>
    <property name="view_model">SubResource("VM_game")</property>
  </node>
  <node name="FrameEnvironment" type="WorldEnvironment" parent=".">
    <property name="environment">SubResource("Env_frame")</property>
  </node>
  <node name="Screen" type="Camera3D" parent=".">
    <property name="current">true</property>
  </node>
  <node name="Present" type="MeshInstance3D" parent="Screen">
    <property name="mesh">SubResource("Mesh_present")</property>
    <property name="position">Vector3(0, 0, -1)</property>
  </node>
  <node name="Anchor" type="MeshInstance3D" parent="Screen">
    <property name="mesh">SubResource("Mesh_anchor")</property>
    <property name="position">Vector3(0, 0, -2)</property>
  </node>
  <node name="LowRes" type="SubViewport" parent=".">
    <property name="size">Vector2i(320, 240)</property>
    <property name="render_target_update_mode">4</property>
    <property name="own_world_3d">true</property>
  </node>
  <!-- the course brings the game world's Environment (depth fog), its sky and the
       Daylight timeline that course/course.rscn's script scrubs along the progress -->
  <node name="Course" parent="LowRes" instance="ExtResource(&quot;6_course&quot;)"/>
  <node name="Rider" parent="LowRes" instance="ExtResource(&quot;7_rider&quot;)"/>
  <!-- the rider's screen anchor for the HUD's pop-ups: scripts/run.as keeps it
       1.2 m over the rider; its outputs are bound, no pin needed -->
  <node name="RiderAnchor" type="Node3D" parent="LowRes">
    <binding property="screen_position:x" path="riderX" mode="to_source"/>
    <binding property="screen_position:y" path="riderY" mode="to_source"/>
  </node>
  <node name="Lens" type="Camera3D" parent="LowRes">
    <property name="script">ExtResource("5_camera")</property>
    <property name="position">Vector3(0, 2.5, 5)</property>
    <property name="rotation_degrees">Vector3(-12, 0, 0)</property>
    <property name="fov">66</property>
    <property name="near">0.1</property>
    <property name="far">200</property>
    <property name="current">true</property>
  </node>
  <node name="Sound" type="Node" parent=".">
    <property name="script">ExtResource("4_sound")</property>
  </node>
  <!-- the pins (tools/pins.py, docs/RIVE.md section 4) -->
  <node name="Pins" type="Node3D" parent=".">
    <property name="visible">false</property>
  </node>
  <node name="In" type="Node3D" parent="Pins"/>
  <node name="Phase" type="Node3D" parent="Pins">
    <binding property="position:x" path="phase" mode="to_source"/>
  </node>
  <node name="Score" type="Node3D" parent="Pins">
    <binding property="position:x" path="score" mode="to_source"/>
  </node>
  <node name="ComboSum" type="Node3D" parent="Pins">
    <binding property="position:x" path="comboSum" mode="to_source"/>
