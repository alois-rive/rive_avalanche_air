  <LinearAnimation name="Daylight" fps="1000" duration="1000" loopValue="oneShot">
    <KeyedObject target="Keys/accent">
      <KeyedProperty property="material_override:shader_parameter/sun_direction:x">
        <KeyFrameDouble frame="0" value="-0.5064" interpolationType="linear"/>
        <KeyFrameDouble frame="438" value="-0.5455" interpolationType="linear"/>
        <KeyFrameDouble frame="685" value="-0.5649" interpolationType="linear"/>
        <KeyFrameDouble frame="911" value="-0.5728" interpolationType="linear"/>
        <KeyFrameDouble frame="1000" value="-0.5735" interpolationType="linear"/>
      </KeyedProperty>
      <KeyedProperty property="material_override:shader_parameter/sun_direction:y">
        <KeyFrameDouble frame="0" value="0.4695" interpolationType="linear"/>
        <KeyFrameDouble frame="438" value="0.309" interpolationType="linear"/>
        <KeyFrameDouble frame="685" value="0.1736" interpolationType="linear"/>
        <KeyFrameDouble frame="911" value="0.0523" interpolationType="linear"/>
        <KeyFrameDouble frame="1000" value="0.0175" interpolationType="linear"/>
      </KeyedProperty>
      <KeyedProperty property="material_override:shader_parameter/sun_direction:z">
        <KeyFrameDouble frame="0" value="-0.7233" interpolationType="linear"/>
        <KeyFrameDouble frame="438" value="-0.7791" interpolationType="linear"/>
        <KeyFrameDouble frame="685" value="-0.8067" interpolationType="linear"/>
        <KeyFrameDouble frame="911" value="-0.818" interpolationType="linear"/>
        <KeyFrameDouble frame="1000" value="-0.819" interpolationType="linear"/>
      </KeyedProperty>
      <KeyedProperty property="material_override:shader_parameter/sun_color">
        <KeyFrameColor frame="0" value="FFC6B386" interpolationType="linear"/>
        <KeyFrameColor frame="438" value="FFC6A066" interpolationType="linear"/>
        <KeyFrameColor frame="685" value="FFC6804D" interpolationType="linear"/>
        <KeyFrameColor frame="911" value="FFC66040" interpolationType="linear"/>
        <KeyFrameColor frame="1000" value="FFBA4D3A" interpolationType="linear"/>
      </KeyedProperty>
      <KeyedProperty property="material_override:shader_parameter/sky_ambient">
        <KeyFrameColor frame="0" value="FF8898C8" interpolationType="linear"/>
        <KeyFrameColor frame="438" value="FF8890C0" interpolationType="linear"/>
        <KeyFrameColor frame="685" value="FF8878B0" interpolationType="linear"/>
        <KeyFrameColor frame="911" value="FF605890" interpolationType="linear"/>
