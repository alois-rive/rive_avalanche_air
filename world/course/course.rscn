    <property name="shader_parameter/uv_offset">Vector2(0.75, 0)</property>
    <property name="shader_parameter/sun_color">Color(0, 0, 0, 1)</property>
    <property name="shader_parameter/sky_ambient">Color(1, 1, 1, 1)</property>
    <property name="shader_parameter/ground_ambient">Color(1, 1, 1, 1)</property>
    <property name="shader_parameter/overbright">1.4</property>
    <property name="shader_parameter/snap_resolution">Vector2(0, 0)</property>
  </sub_resource>
  <sub_resource id="Mesh_flare3" type="QuadMesh">
    <property name="material">SubResource("Mat_flare3")</property>
  </sub_resource>
  <sub_resource id="Ramp_age" type="Gradient">
    <property name="offsets">PackedFloat32Array(0, 1)</property>
    <property name="colors">PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)</property>
  </sub_resource>
  <sub_resource id="Mat_flake" type="ShaderMaterial">
    <property name="shader">ExtResource("9_sprite")</property>
    <property name="shader_parameter/sprite_sheet">ExtResource("tex_fx_flake")</property>
    <property name="shader_parameter/frames_x">2</property>
    <property name="shader_parameter/frames_y">1</property>
  </sub_resource>
  <sub_resource id="Mesh_flake" type="QuadMesh">
    <property name="size">Vector2(0.22, 0.22)</property>
    <property name="material">SubResource("Mat_flake")</property>
  </sub_resource>
  <sub_resource id="Mat_confetti" type="ShaderMaterial">
    <property name="shader">ExtResource("9_sprite")</property>
    <property name="shader_parameter/sprite_sheet">ExtResource("tex_fx_confetti")</property>
    <property name="shader_parameter/frames_x">2</property>
    <property name="shader_parameter/frames_y">1</property>
  </sub_resource>
  <sub_resource id="Mesh_confetti" type="QuadMesh">
    <property name="size">Vector2(0.3, 0.3)</property>
    <property name="material">SubResource("Mat_confetti")</property>
  </sub_resource>
  <sub_resource id="Ramp_confetti" type="Gradient">
    <property name="interpolation_mode">1</property>
    <property name="offsets">PackedFloat32Array(0, 0.25, 0.5, 0.75)</property>
    <property name="colors">PackedColorArray(0.97, 0.22, 0.56, 1, 0.66, 0.97, 0.19, 1, 0.97, 0.53, 0.09, 1, 0.19, 0.85, 0.97, 1)</property>
  </sub_resource>

  <node name="Course" type="Node3D">
    <property name="script">ExtResource("7_daylight")</property>
  </node>
  <!-- the game world's environment and sky (the sky follows the lens: scripts/daylight.as) -->
  <node name="Environment" type="WorldEnvironment" parent=".">
    <property name="environment">SubResource("Env_game")</property>
  </node>
  <node name="Sky" type="MeshInstance3D" parent=".">
